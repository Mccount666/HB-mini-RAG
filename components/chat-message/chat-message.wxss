/* components/chat-message/chat-message.wxss */
.msg-row {
  display: flex;
  margin: 36rpx 0;
  align-items: flex-start;
}
.row-user {
  flex-direction: row-reverse;
}

/* AI 头像 */
.bot-avatar-wrap {
  margin-right: -10rpx;
  z-index: 2;
  position: relative;
  top: 10rpx;
}
.bot-avatar {
  width: 56rpx;
  height: 56rpx;
  background: var(--brand-soft);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.heart-icon {
  width: 32rpx;
  height: 32rpx;
}

/* 气泡本体 */
.bubble {
  max-width: 78%;
  padding: 26rpx 32rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
  position: relative;
  z-index: 1;
}
.bubble-bot {
  background: var(--bot-bubble);
  color: var(--text);
  border-top-left-radius: 8rpx;
  box-shadow: 0 4rpx 12rpx rgba(222, 160, 104, 0.05); /* 极弱暖阴影 */
  margin-left: 20rpx;
}
.bubble-user {
  background: var(--user-bubble);
  color: #fff;
  border-top-right-radius: 8rpx;
  box-shadow: 0 2rpx 10rpx rgba(222, 160, 104, 0.2);
}

.content-box {
  white-space: pre-wrap;
}

/* OCR 缩略图 */
.ocr-thumb {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255,255,255,0.3);
}
.ocr-img {
  width: 100%;
  height: 100%;
}

/* OCR 两段式区 */
.ocr-box {
  width: 100%;
}
.ocr-title {
  font-size: 26rpx;
  font-weight: 500;
  color: var(--brand-deep);
  margin-bottom: 20rpx;
}
.ocr-confirm-input {
  width: 100%;
  background: #FBF7F2;
  border: 1px solid var(--brand-soft);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.5;
  box-sizing: border-box;
}
.ocr-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}
.btn-plain, .btn-solid {
  font-size: 26rpx;
  text-align: center;
  border-radius: 30rpx;
  padding: 12rpx 28rpx;
}
.btn-plain { background: transparent; color: var(--text-sub); }
.btn-solid { background: var(--brand); color: #fff; }

.raw-box { margin-top: 20rpx; }
.raw-toggle { font-size: 24rpx; color: var(--brand-deep); }
.raw-text { font-size: 24rpx; color: var(--text-sub); margin-top: 10rpx; line-height: 1.6; }

/* 来源小胶囊 */
.source-area {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 1rpx dashed var(--brand-soft);
}
.source-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.source-tag {
  display: inline-flex;
  align-items: center;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 30rpx;
  align-self: flex-start;
}
.book-ico {
  width: 24rpx;
  height: 24rpx;
  margin-right: 8rpx;
}

/* 底部评价点赞（内嵌，去掉绝对定位） */
.feedback-area {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed var(--brand-soft);
}
.rate-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.rate-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--brand-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(222, 160, 104, 0.1);
}
.rate-btn-bad {
  background: #FBF0F0;
}
.heart-ico {
  width: 26rpx;
  height: 26rpx;
}
.bad-ico {
  font-size: 26rpx;
  color: #D36C6C;
  line-height: 1;
}
.rate-hint {
  font-size: 22rpx;
  color: var(--text-sub);
}
.rate-done {
  font-size: 22rpx;
  color: var(--brand-deep);
}

/* 加载动画 */
.loading-box { display: flex; gap: 8rpx; padding: 10rpx; }
.dot {
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: var(--brand-soft);
  animation: blink 1.4s infinite reverse;
}
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0% { opacity: 0.2; } 20% { opacity: 1; } 100% { opacity: 0.2; } }
