.about {
  min-height: 100vh;
  padding: 32rpx 28rpx;
  background-color: var(--bg);
}
.block {
  background: var(--card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(222, 160, 104, 0.05);
}
.block.warn {
  background: var(--brand-soft);
  border: none;
}
.title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: var(--brand-deep);
}
.block.warn .title {
  color: #8C5D3B;
}
.text {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.8;
  white-space: pre-wrap;
}
