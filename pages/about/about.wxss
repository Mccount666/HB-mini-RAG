.about {
  height: 100vh;
  padding: 32rpx 28rpx;
}
.block {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.block.warn {
  background: #fff7e6;
  border: 1rpx solid #ffe1a8;
}
.title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  color: #07c160;
}
.block.warn .title {
  color: #ad6800;
}
.text {
  font-size: 26rpx;
  color: #4a5057;
  line-height: 1.8;
  white-space: pre-wrap;
}
