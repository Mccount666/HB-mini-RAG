.history {
  padding: 24rpx;
  background-color: var(--bg);
  min-height: 100vh;
}
.empty {
  text-align: center;
  color: var(--text-sub);
  margin-top: 120rpx;
  font-size: 28rpx;
}
/* 搜索框 */
.search {
  position: relative;
  margin-bottom: 20rpx;
}
.search-input {
  background: var(--card);
  border-radius: 40rpx;
  padding: 20rpx 72rpx 20rpx 32rpx;
  font-size: 26rpx;
  color: var(--text);
  box-shadow: 0 4rpx 12rpx rgba(222, 160, 104, 0.05);
}
.search-ph {
  color: #C4B5AC;
}
.search-clear {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-size: 30rpx;
}
/* 主题筛选条 */
.chips {
  white-space: nowrap;
  margin-bottom: 24rpx;
}
.chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-sub);
  background: var(--card);
  box-shadow: 0 4rpx 12rpx rgba(222, 160, 104, 0.05);
}
.chip-on {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}
.compare-entry {
  background: var(--card);
  border-radius: 24rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand-deep);
  box-shadow: 0 4rpx 12rpx rgba(222, 160, 104, 0.05);
}
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(222, 160, 104, 0.05); /* 统一弱暖影 */
}
.q-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}
.q {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}
.star {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 36rpx;
  line-height: 1.2;
  color: #C4B5AC;
  padding: 0 8rpx;
}
.star-on {
  color: var(--brand);
}
.a {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.meta-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.meta {
  font-size: 22rpx;
  color: #C4B5AC;
}
.del {
  font-size: 22rpx;
  color: #D36C6C;
  padding: 8rpx 20rpx;
}
.clear {
  text-align: center;
  color: #D36C6C;
  font-size: 26rpx;
  margin-top: 40rpx;
  padding: 20rpx;
}
.page-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 40rpx;
}
.action-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 22rpx 0;
  border-radius: 40rpx;
  background: var(--brand-soft);
  color: var(--brand-deep);
  font-weight: 600;
}
.action-danger {
  background: #FBF0F0;
  color: #D36C6C;
}
