.history {
  padding: 24rpx;
  background-color: var(--bg);
  min-height: 100vh;
}
.empty {
  text-align: center;
  color: var(--text-sub);
  margin-top: 120rpx;
  font-size: 28rpx;
}
.card {
  background: var(--card);
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(222, 160, 104, 0.05); /* 统一弱暖影 */
}
.q {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}
.a {
  font-size: 26rpx;
  color: var(--text-sub);
  line-height: 1.6;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}
.meta-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.meta {
  font-size: 22rpx;
  color: #C4B5AC;
}
.del {
  font-size: 22rpx;
  color: #D36C6C;
  padding: 8rpx 20rpx;
}
.clear {
  text-align: center;
  color: #D36C6C;
  font-size: 26rpx;
  margin-top: 40rpx;
  padding: 20rpx;
}
