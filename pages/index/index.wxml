<view class="page-container">
  <!-- 背景氛围涂鸦（淡色，勿抢戏） -->
  <view class="bg-decor blob-a"></view>
  <view class="bg-decor star-a">✦</view>
  <view class="bg-decor star-b">✧</view>

  <scroll-view class="msg-list" scroll-y scroll-into-view="{{scrollTarget}}" scroll-with-animation enhanced show-scrollbar="{{false}}">
    <!-- 顶部免责提示卡片 -->
    <view class="disclaimer-card">
      <view class="shield-icon"></view>
      <text class="disclaimer-text">本助手仅基于权威知识库作答，不能替代主治医生诊断。急症请立即就医。</text>
    </view>

    <view wx:if="{{messages.length === 0}}" class="empty-box">
      <view class="empty-title">您好，我是肝芽小助手</view>
      <view class="empty-sub">您可以问我关于疾病、治疗、护理、随访的问题。</view>
      <view class="quick-list">
        <view class="quick-item" wx:for="{{quickQuestions}}" wx:key="*this" bindtap="onQuickTap" data-q="{{item}}">
          <text class="quick-text">{{item}}</text>
          <text class="quick-arrow">›</text>
        </view>
      </view>
    </view>

    <block wx:for="{{messages}}" wx:key="id">
      <chat-message
        id="msg-{{item.id}}"
        role="{{item.role}}"
        type="{{item.type}}"
        content="{{item.content}}"
        imagePath="{{item.imagePath}}"
        rawText="{{item.rawText}}"
        sources="{{item.sources}}"
        topic="{{item.topic}}"
        loading="{{item.loading}}"
        rating="{{item.rating}}"
        ocrStage="{{item.ocrStage}}"
        data-id="{{item.id}}"
        bindrate="onRate"
        bindconfirmocr="onConfirmOcr"
        bindretakeocr="onRetakeOcr"
      />
    </block>

    <view class="list-bottom-gap"></view>
  </scroll-view>

  <view wx:if="{{showPrivacy}}" class="privacy-mask">
    <view class="privacy-dialog">
      <view class="privacy-title">隐私授权提示</view>
      <view class="privacy-text">上传化验单需要使用相册或相机，并将图片临时上传到云端用于 OCR 文字识别和解读。我们仅用于本次识别，不会公开您的报告内容。</view>
      <view class="privacy-link" bindtap="openPrivacyContract">查看《用户隐私保护指引》</view>
      <view class="privacy-actions">
        <button class="privacy-btn secondary" bindtap="onRejectPrivacyAuthorization">暂不同意</button>
        <button id="agree-btn" class="privacy-btn primary" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="onAgreePrivacyAuthorization">同意并继续</button>
      </view>
    </view>
  </view>

  <!-- 底部输入区：白色圆角托板 -->
  <view class="input-area">
    <view class="upload-circle {{sending ? 'disabled' : ''}}" bindtap="onUpload">
      <text class="plus-icon">＋</text>
    </view>
    <input
      class="main-input"
      value="{{inputValue}}"
      bindinput="onInput"
      confirm-type="send"
      bindconfirm="onSend"
      placeholder="输入您的问题..."
      placeholder-class="input-placeholder"
      disabled="{{sending}}"
    />
    <view class="send-circle {{sending ? 'disabled' : ''}}" bindtap="onSend">
      <view class="plane-icon"></view>
    </view>
  </view>
</view>
