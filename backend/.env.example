# ===== 服务 =====
PORT=3000

# ===== 大模型（OpenAI 兼容接口，默认 DeepSeek）=====
# DeepSeek 注册地址：https://platform.deepseek.com
# 重要：DeepSeek 的聊天接口需要 /v1 前缀，baseUrl 必须带 /v1
LLM_API_KEY=sk-你的DeepSeekKey在这里填
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=800
# 超时（毫秒）与重试次数：429/5xx/网络错误自动重试
LLM_TIMEOUT_MS=60000
LLM_MAX_RETRIES=1

# ===== 向量化（DeepSeek 无 embedding 接口，默认走本地 keyless 方案）=====
# 默认 provider=local：免 key，整套系统只用上面的 DeepSeek Key 即可跑通。
# 若需更高质量检索，可改为 provider=api 并提供下方 key（如 OpenAI / 中文 embedding 服务）：
#   EMBEDDING_PROVIDER=api
#   EMBEDDING_API_KEY=sk-xxx
#   EMBEDDING_BASE_URL=https://api.openai.com/v1
#   EMBEDDING_MODEL=text-embedding-3-small
#   EMBEDDING_DIM=1536
EMBEDDING_PROVIDER=local
# api 向量化超时（毫秒）与重试次数（429/5xx/网络错误自动重试）
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=1

# ===== 检索参数（控制幻觉的核心旋钮）=====
# 返回 topK 个最相关条目
RETRIEVAL_TOP_K=6
# 混合检索权重：score = weightVector*余弦 + weightBm25*BM25归一分
RETRIEVAL_WEIGHT_VECTOR=0.5
RETRIEVAL_WEIGHT_BM25=0.5
# 融合分阈值：低于此值视为"知识库无相关内容"，直接拒答不调模型。
# local 向量化默认 0.50（2026-08-30 知识库扩至 107 条后实测校准），api 向量化默认 0.45。
# 改配置后务必跑 node tools/eval.js 校准。
RETRIEVAL_THRESHOLD=0.50
# 覆盖率门控（可选，默认 0=关闭）：问题关键词在语料中的覆盖率过低则整题拒答。
# 口语化提问同样会拉低覆盖率，无法与近邻问题统计分隔，故仅作 eval 观测指标。
RETRIEVAL_MIN_COVERAGE=0
# 严格模式：true 时未命中阈值则根本不调用大模型，零幻觉
STRICT_RETRIEVAL=true

# ===== 生成后护栏（医学安全，建议保持开启）=====
# 关键数字（带单位/含小数/大于20）必须能在知识库命中条目中找到原文，否则整条拒答
GUARD_CHECK_NUMBERS=true
# 回答至少含一处有效 [来源N] 引用，缺失时强化重试一次，仍缺失则拒答
GUARD_REQUIRE_CITATIONS=true

# ===== 知识库安全门控 =====
# 上线前务必设为 true：仅收录导师已审核(reviewed=true 且 reviewedBy 非空)的内容，演示数据不进检索库
KB_ONLY_REVIEWED=false

# ===== HTTP 端点防护（自托管后端与云函数 HTTP 云接入共用）=====
# CORS 白名单：网页版部署域名（逗号分隔）。未配置=全放行（仅限本地开发）。
ALLOWED_ORIGINS=https://你的网页版域名.example
# 共享密钥：配置后，HTTP 请求必须带 x-hb-secret 请求头才受理（网页版 rag-client 会带上）。
# 留空 = 不校验（仅限本地开发/演示）。小程序直调不受影响。
HTTP_SHARED_SECRET=
# 每 IP 每分钟最多请求数（HTTP 云接入限速，超出返回 429）
HTTP_RATE_LIMIT=20
# 反馈提交限速（双层）：
#   层1 FEEDBACK_RATE_LIMIT：每身份/内容桶每分钟上限（默认 5，超出返回 { ok:false, error:'提交过于频繁' }）。
#      云函数按 OPENID / IP 归因；拿不到身份时按反馈内容哈希分桶，避免所有匿名访客共用一个桶被误限。
#   层2 FEEDBACK_RATE_LIMIT_GLOBAL：全局兜底桶，每实例每分钟总上限（默认 200，超出返回 '服务繁忙'）。
#      匿名分桶的键含调用方可控的反馈内容，仅靠层1可被「每次变体内容」绕过（审查报告待办 H），必须有实例级总闸。
FEEDBACK_RATE_LIMIT=5
FEEDBACK_RATE_LIMIT_GLOBAL=200
# 管理类端点令牌：反馈查看（GET /api/feedback，自托管后端）与学习队列查看
# （GET /api/learn-queue，云函数）共用；请求须带 x-admin-token 头。留空 = 关闭对应端点。
# 注意：这是管理令牌，与网页访客用的 HTTP_SHARED_SECRET 分开，不要写进公开网页代码。
ADMIN_TOKEN=

# ===== 化验单 OCR 识别（可插拔）=====
# provider=mock    : 默认，免 key，返回一份演示化验单文本，便于无 OCR key 时跑通整条管线
# provider=tencent : 腾讯云 OCR（通用印刷体 GeneralBasicOCR），在腾讯云控制台开通「文字识别」后填下方密钥
OCR_PROVIDER=mock
# TENCENT_SECRET_ID=你的腾讯云 SecretId
# TENCENT_SECRET_KEY=你的腾讯云 SecretKey
# TENCENT_OCR_REGION=ap-guangzhou
